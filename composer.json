{
  "name": "g2rd/g2rd-woocommerce-promotions",
  "description": "Campagnes promotionnelles WooCommerce par label, catégorie et profil client.",
  "type": "wordpress-plugin",
  "license": "GPL-2.0-or-later",
  "authors": [
    {
      "name": "Sebastien Gerard",
      "email": "contact@g2rd.fr",
      "homepage": "https://g2rd.fr"
    }
  ],
  "require": {
    "php": ">=8.1"
  },
  "require-dev": {
    "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
    "pheromone/phpcs-security-audit": "^2.0",
    "phpcompatibility/phpcompatibility-wp": "^2.1",
    "phpstan/phpstan": "^1.12",
    "squizlabs/php_codesniffer": "^3.10",
    "szepeviktor/phpstan-wordpress": "^1.3",
    "wp-coding-standards/wpcs": "^3.1"
  },
  "config": {
    "optimize-autoloader": true,
    "sort-packages": true,
    "platform": {
      "php": "8.1.31"
    },
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    }
  },
  "scripts": {
    "test": "php tests/run.php",
    "lint": "phpcs --standard=phpcs.xml.dist",
    "lint:fix": "phpcbf --standard=phpcs.xml.dist",
    "lint:security": "phpcs --standard=phpcs-security.xml --runtime-set ParanoiaMode 0",
    "analyse": "phpstan analyse --memory-limit=1G",
    "js:check": "node --check assets/admin.js",
    "ci": [
      "@test",
      "@js:check",
      "@lint:security",
      "@analyse"
    ]
  }
}
