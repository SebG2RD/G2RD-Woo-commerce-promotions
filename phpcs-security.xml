<?xml version="1.0"?>
<ruleset name="G2RD WooCommerce Promotions Security">
	<description>SAST OWASP (phpcs-security-audit). Bloquant en CI : le plugin manipule des prix et des profils Wholesale.</description>

	<file>./g2rd-woocommerce-promotions.php</file>
	<file>./uninstall.php</file>
	<file>./includes</file>

	<arg name="extensions" value="php"/>
	<arg name="colors"/>
	<arg value="ps"/>

	<rule ref="Security">
		<!-- Faux positifs : chemins dérivés de constantes plugin / __DIR__. -->
		<exclude name="Security.BadFunctions.FilesystemFunctions"/>
		<!-- Faux positifs : callables internes (array_map, filtres). -->
		<exclude name="Security.BadFunctions.CallbackFunctions"/>
	</rule>

	<exclude-pattern>*/vendor/*</exclude-pattern>
	<exclude-pattern>*/tests/*</exclude-pattern>
	<exclude-pattern>*/docs/*</exclude-pattern>
</ruleset>
