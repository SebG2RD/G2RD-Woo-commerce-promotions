# Fins de ligne normalisées.
* text=auto eol=lf
*.php text eol=lf
*.js text eol=lf
*.css text eol=lf
*.md text eol=lf
*.sh text eol=lf
*.yml text eol=lf

# Exclus des archives « git archive » (le ZIP de release est construit par tools/build-zip.php).
/.github        export-ignore
/.ci-refs       export-ignore
/.claude        export-ignore
/docs           export-ignore
/tests          export-ignore
/tools          export-ignore
/.gitattributes export-ignore
/.gitignore     export-ignore
/phpcs.xml.dist export-ignore
/phpcs-security.xml export-ignore
/phpstan.neon.dist export-ignore
/composer.json  export-ignore
/composer.lock  export-ignore
/README.md      export-ignore
/CLAUDE.md      export-ignore
